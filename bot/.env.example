# Copy this file to .env and fill in your values

# ── Email ───────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password    # Gmail: generate at myaccount.google.com/apppasswords

EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com         # where alerts land (can be same address)

# ── Polling ─────────────────────────────────────────────────────────────────────
POLL_INTERVAL_MINUTES=15
DIGEST_HOUR=8                  # hour (UTC) to send daily digest emails
