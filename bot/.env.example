# ── SMTP (required for alerts) ─────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false          # set true for port 465
SMTP_USER=user@example.com
SMTP_PASS=your_password

EMAIL_FROM=craigslist-monitor@example.com
EMAIL_TO=you@example.com

# ── Proxy (required on Railway / cloud — Craigslist blocks datacenter IPs) ──────
# Use a residential proxy service (e.g. Bright Data, Oxylabs, SmartProxy)
# HTTPS_PROXY=http://user:pass@proxy.example.com:8080

# ── Polling ─────────────────────────────────────────────────────────────────────
POLL_INTERVAL_MINUTES=15
DIGEST_HOUR=8              # hour (UTC) for daily digest emails

# ── Storage paths (override for Railway volume mount) ───────────────────────────
DB_DIR=/app/data
LOG_DIR=/app/logs
